  ctl.auto=false; tween.active=false;
});
el.addEventListener('pointermove',e=>{
  if(!pointers.has(e.pointerId)) return;
  const p=pointers.get(e.pointerId);
  const dx=e.clientX-p.x, dy=e.clientY-p.y;
  p.x=e.clientX; p.y=e.clientY;
  if(pointers.size===1){
    if(p.btn===2 || p.btn===1 || e.shiftKey) panBy(dx,dy);
    else { ctl.dTheta-=dx*0.0035; ctl.dPhi-=dy*0.0035; }
  } else if(pointers.size===2){
    const pts=[...pointers.values()];
    const d=Math.hypot(pts[0].x-pts[1].x, pts[0].y-pts[1].y);
    if(lastPinch>0) ctl.dRad += (lastPinch-d)*0.0018;
    lastPinch=d;
    panBy(dx*0.5,dy*0.5);
  }
});
function endPointer(e){ pointers.delete(e.pointerId); if(pointers.size<2) lastPinch=0; }
