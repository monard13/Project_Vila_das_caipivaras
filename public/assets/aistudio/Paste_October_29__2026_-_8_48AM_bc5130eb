  ctl.target.x=THREE.MathUtils.clamp(ctl.target.x,-160,160);
  ctl.target.z=THREE.MathUtils.clamp(ctl.target.z,-160,120);
  const sp=Math.sin(ctl.phi);
  camera.position.set(
    ctl.target.x + ctl.radius*sp*Math.sin(ctl.theta),
    ctl.target.y + ctl.radius*Math.cos(ctl.phi),
