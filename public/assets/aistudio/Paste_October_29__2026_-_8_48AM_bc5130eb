  labelGroup.add(sp);
  const lineG=new THREE.BufferGeometry().setFromPoints(
    [new THREE.Vector3(x,anchorY,z), new THREE.Vector3(x,y-h*k/2,z)]);
  labelGroup.add(new THREE.Line(lineG,new THREE.LineBasicMaterial({color:PALETTE.oceano,transparent:true,opacity:.75})));
}
