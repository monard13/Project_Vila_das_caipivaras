<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Vila Capivaras — Idea A · Rediseño 3D</title>
<style>
  :root{
    --oceano:#0E3A53; --oceano2:#123F5C; --teal:#17798A; --dorado:#D9A441;
    --arena:#F3ECDD; --blanco:#FBFAF6; --tinta:#0B2A3C;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{height:100%;overflow:hidden;background:#0E3A53;
    font-family:Calibri,'Segoe UI',system-ui,Arial,sans-serif;color:var(--tinta)}
  #stage{position:fixed;inset:0}
  canvas{display:block}

  .card{
    position:fixed;top:14px;left:14px;z-index:10;max-width:min(430px,calc(100vw - 28px));
    background:rgba(243,236,221,.94);border:1px solid rgba(14,58,83,.25);
    border-left:4px solid var(--dorado);border-radius:10px;
    padding:12px 16px 12px 14px;box-shadow:0 8px 28px rgba(11,42,60,.28);
    backdrop-filter:blur(6px);
  }
  .eyebrow{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--teal);font-weight:700}
  h1{font-family:Cambria,Georgia,'Times New Roman',serif;font-size:26px;line-height:1.05;
     color:var(--oceano);letter-spacing:.02em;margin:2px 0 1px;font-variant:small-caps}
  .sub{font-size:12.5px;color:#3d5566;margin-bottom:8px}
  .chips{display:flex;flex-wrap:wrap;gap:5px}
  .chip{font-size:11px;font-weight:600;color:var(--oceano);background:var(--blanco);
    border:1px solid rgba(14,58,83,.22);border-radius:999px;padding:3px 9px;white-space:nowrap;
    font-variant-numeric:tabular-nums}
  .chip b{color:var(--teal)}

  .controls{position:fixed;top:14px;right:14px;z-index:10;display:flex;flex-direction:column;
    gap:6px;align-items:flex-end}
  .group{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}
  button{
    font-family:inherit;font-size:12px;font-weight:700;color:var(--oceano);
    background:rgba(243,236,221,.94);border:1px solid rgba(14,58,83,.3);
    border-radius:999px;padding:7px 12px;cursor:pointer;box-shadow:0 3px 12px rgba(11,42,60,.22);
    transition:background .15s,color .15s,transform .05s;
  }
  button:hover{background:var(--blanco)}
  button:active{transform:translateY(1px)}
  button:focus-visible{outline:3px solid var(--dorado);outline-offset:2px}
  button.on{background:var(--oceano);color:var(--dorado);border-color:var(--oceano)}
  button.icon{padding:7px 10px}

  .compass{position:fixed;right:16px;bottom:74px;z-index:10;width:46px;height:46px;border-radius:50%;
    background:rgba(243,236,221,.92);border:1px solid rgba(14,58,83,.3);
    box-shadow:0 3px 12px rgba(11,42,60,.25);display:flex;align-items:center;justify-content:center}
  .needle{width:100%;height:100%;position:relative;transition:transform .08s linear}
  .needle:before{content:"";position:absolute;left:50%;top:6px;transform:translateX(-50%);
    border-left:5px solid transparent;border-right:5px solid transparent;border-bottom:14px solid var(--dorado)}
  .needle:after{content:"N";position:absolute;left:50%;top:19px;transform:translateX(-50%);
    font-size:11px;font-weight:800;color:var(--oceano)}

  .hint{position:fixed;left:50%;bottom:60px;transform:translateX(-50%);z-index:9;
    font-size:12px;color:var(--arena);background:rgba(14,58,83,.78);border-radius:999px;
    padding:6px 14px;pointer-events:none;transition:opacity .8s;white-space:nowrap;max-width:92vw;
    overflow:hidden;text-overflow:ellipsis}

  .legal{position:fixed;left:0;right:0;bottom:0;z-index:10;background:rgba(14,58,83,.92);
    color:#d9e4ea;font-size:10.5px;line-height:1.35;padding:7px 14px;text-align:center;
    border-top:2px solid var(--dorado)}
  .legal b{color:var(--dorado);font-weight:700}

  .loader{position:fixed;inset:0;z-index:30;background:var(--oceano);display:flex;
    flex-direction:column;align-items:center;justify-content:center;gap:14px;
    transition:opacity .6s;color:var(--arena)}
  .loader h2{font-family:Cambria,Georgia,serif;font-variant:small-caps;letter-spacing:.06em;
    color:var(--dorado);font-size:30px;font-weight:600}
  .loader p{font-size:13px;opacity:.85}
  .bar{width:180px;height:3px;background:rgba(243,236,221,.25);border-radius:2px;overflow:hidden}
  .bar i{display:block;width:40%;height:100%;background:var(--dorado);border-radius:2px;
    animation:slide 1.1s ease-in-out infinite}
  @keyframes slide{0%{transform:translateX(-100%)}100%{transform:translateX(350%)}}

  @media (max-width:700px){
    h1{font-size:21px}
    .card{padding:10px 12px 10px 12px;max-width:calc(100vw - 96px)}
    .chips .chip:nth-child(n+4){display:none}
    .controls{top:auto;bottom:104px;right:10px}
    .legal{font-size:9.5px;padding:6px 8px}
    .hint{bottom:76px;font-size:11px}
    .compass{display:none}
  }
  @media (prefers-reduced-motion:reduce){
    .bar i{animation:none;width:100%}
  }
</style>
</head>
<body>
<div id="stage"></div>

<div class="card">
  <div class="eyebrow">Idea A · Rediseño — render conceptual 3D</div>
  <h1>Vila Capivaras</h1>
  <div class="sub">Paseo comercial-gastronómico · gym + rooftop · flats — Lagoa das Capivaras, Búzios (RJ)</div>
  <div class="chips">
    <span class="chip">≈ <b>4.648 m²</b> · Lotes 4–9, Quadra C</span>
    <span class="chip">Acceso único <b>frente a la laguna</b></span>
    <span class="chip">PB <b>~1.200 m²</b> comercial</span>
    <span class="chip">P2 fondo: <b>gym ≈220 m²</b> + rooftop</span>
    <span class="chip">PA <b>6–8 flats</b> · terrazas</span>
    <span class="chip"><b>~60–70</b> plazas parking</span>
  </div>
</div>

<div class="controls">
  <div class="group">
    <button id="v-aerea" class="on" title="Vista aérea">Vista aérea</button>
    <button id="v-paseo" title="A nivel de peatón dentro del paseo">En el paseo</button>
    <button id="v-laguna" title="Desde la Lagoa das Capivaras">Desde la laguna</button>
    <button id="v-rooftop" title="Rooftop fitness sobre el gimnasio">Rooftop</button>
  </div>
  <div class="group">
    <button id="b-sunset" title="Alternar luz de día / atardecer">☀ Atardecer</button>
    <button id="b-labels" class="on" title="Mostrar u ocultar etiquetas">Etiquetas</button>
    <button id="b-png" class="icon" title="Exportar imagen PNG">📸 PNG</button>
    <button id="b-full" class="icon" title="Pantalla completa">⛶</button>
  </div>
</div>

<div class="compass"><div class="needle" id="needle"></div></div>
<div class="hint" id="hint">Arrastra para orbitar · rueda / pellizco para zoom · clic derecho para desplazar</div>

<div class="legal">
  <b>Visualización conceptual no vinculante</b> — no constituye proyecto aprobado. Volumetría, áreas y plazas aproximadas,
  sujetas a verificación urbanística (LUOS Búzios: TO/TI y gabarito; <b>art. 26</b> — galería con acceso por un solo logradouro y
  circulación ≥ 5 m; Anexo 3 — estacionamiento: 1/25 m² comercio · 1/20 m² salón restaurante · 2/flat · academia según Anexo 3) y
  <b>ambiental (Termo de Preservação de Floresta IBDF, 1983</b>, averbado en las matrículas). Situación judicial: ver caveats del resumen ejecutivo.
  Marcas y locatarios mostrados son ficticios e ilustrativos.
</div>

<div class="loader" id="loader">
  <h2>Vila Capivaras</h2>
  <div class="bar"><i></i></div>
  <p>Preparando la maqueta 3D…</p>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
"use strict";
/* =====================================================================
   VILA CAPIVARAS — Idea A · REDISEÑO estilo strip center
   Canopy blanco volado · estructura negra · madera · cartelas de locales
   Se mantiene el parti original: acceso único al norte frente a la
   laguna, paseo central ≥5 m, 5 bloques; bloque E: PB locales +
   P2 gimnasio con rooftop fitness.
   Ejes: +X este · −Z norte (avenida y laguna) · unidades en metros
   ===================================================================== */

const PALETTE = {
  oceano:0x0E3A53, teal:0x17798A, dorado:0xD9A441, arena:0xF3ECDD,
  negro:0x23272B, negro2:0x1B1F23, blancoCanopy:0xF4F2EC, cartela:0xF7F5EF,
  maderaSlat:0x7A4E2C, madera:0x8A5A36, maderaClara:0xA9773F,
  vidrio:0x7FB0BC, vidrioOscuro:0x2E5560, piedra:0xCBC2AC,
  asfalto:0x43484C, acera:0xC9C2B2, clay:0xC06A4C, olive:0x7A8450,
  verde:0x5E7D4A, verdeOscuro:0x3F5C36, tronco:0x6E4E2E,
  agua:0x2E7D8C
};

/* ---------- Renderer / escena ---------- */
const stage = document.getElementById('stage');
const renderer = new THREE.WebGLRenderer({antialias:true, preserveDrawingBuffer:true});
renderer.setPixelRatio(Math.min(window.devicePixelRatio,2));
renderer.setSize(innerWidth,innerHeight);
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.outputEncoding = THREE.sRGBEncoding;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.05;
stage.appendChild(renderer.domElement);

const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(46, innerWidth/innerHeight, .5, 2500);

/* ---------- Utilidades ---------- */
const matCache = {};
function mat(color, rough=0.9, metal=0.0, opts={}){
  const key = color+'_'+rough+'_'+metal+'_'+(opts.transparent?opts.opacity:1)+'_'+(opts.emissive||0)+'_'+(opts.ei||0);
  if(!matCache[key]){
    matCache[key] = new THREE.MeshStandardMaterial(Object.assign({
      color, roughness:rough, metalness:metal
    }, opts.transparent?{transparent:true, opacity:opts.opacity}:{},
       opts.emissive?{emissive:opts.emissive, emissiveIntensity:opts.ei||0.4}:{}));
  }
  return matCache[key];
}
function box(w,h,d,material,x=0,y=0,z=0,cast=true,recv=true){
  const m = new THREE.Mesh(new THREE.BoxGeometry(w,h,d), material);
  m.position.set(x,y,z); m.castShadow=cast; m.receiveShadow=recv;
  return m;
}
function cyl(rt,rb,h,material,x=0,y=0,z=0,seg=10,cast=true){
  const m = new THREE.Mesh(new THREE.CylinderGeometry(rt,rb,h,seg), material);
  m.position.set(x,y,z); m.castShadow=cast; m.receiveShadow=true;
  return m;
}
function plane(w,d,material,x=0,y=0,z=0,recv=true){
  const m = new THREE.Mesh(new THREE.PlaneGeometry(w,d), material);
  m.rotation.x = -Math.PI/2; m.position.set(x,y,z); m.receiveShadow=recv;
  return m;
}
function canvasTex(w,h,draw,repX=1,repY=1){
  const c = document.createElement('canvas'); c.width=w; c.height=h;
  draw(c.getContext('2d'), w, h);
  const t = new THREE.CanvasTexture(c);
  t.encoding = THREE.sRGBEncoding;
  t.wrapS = t.wrapT = THREE.RepeatWrapping;
  t.repeat.set(repX,repY);
  t.anisotropy = 4;
  return t;
}
function noise(ctx,w,h,alpha,n=1400){
  ctx.globalAlpha = alpha;
  for(let i=0;i<n;i++){
    ctx.fillStyle = Math.random()>.5 ? '#ffffff' : '#000000';
    ctx.fillRect(Math.random()*w, Math.random()*h, 1.6, 1.6);
  }
  ctx.globalAlpha = 1;
}

/* ---------- Cielo, luces, niebla ---------- */
function skyTexture(top, mid, bottom){
  return canvasTex(16,512,(ctx,w,h)=>{
    const g = ctx.createLinearGradient(0,0,0,h);
    g.addColorStop(0,top); g.addColorStop(.55,mid); g.addColorStop(1,bottom);
    ctx.fillStyle = g; ctx.fillRect(0,0,w,h);
  });
}
const skyDay    = skyTexture('#7fbbdf','#bcdcee','#eef4ec');
const skySunset = skyTexture('#2f4d6b','#d9825e','#f6c98a');
const skyMat = new THREE.MeshBasicMaterial({map:skyDay, side:THREE.BackSide, fog:false});
const skyDome = new THREE.Mesh(new THREE.SphereGeometry(1100,24,14), skyMat);
scene.add(skyDome);

const hemi = new THREE.HemisphereLight(0xdfeef7, 0x8a7a5c, 0.85);
scene.add(hemi);
const sun = new THREE.DirectionalLight(0xfff2df, 1.35);
sun.position.set(65,95,-35);
sun.castShadow = true;
sun.shadow.mapSize.set(2048,2048);
sun.shadow.camera.left=-130; sun.shadow.camera.right=130;
sun.shadow.camera.top=130; sun.shadow.camera.bottom=-130;
sun.shadow.camera.near=10; sun.shadow.camera.far=400;
sun.shadow.bias = -0.0004;
scene.add(sun);
const fill = new THREE.DirectionalLight(0xcfe3ec, 0.28);
fill.position.set(-70,40,60);
scene.add(fill);
scene.fog = new THREE.Fog(0xdcecf2, 240, 900);

/* ---------- Terreno base ---------- */
const grassTex = canvasTex(256,256,(ctx,w,h)=>{
  ctx.fillStyle = '#7c9159'; ctx.fillRect(0,0,w,h);
  for(let i=0;i<900;i++){
    ctx.fillStyle = ['#71874f','#87a067','#6d8350','#8fa571'][i%4];
    ctx.fillRect(Math.random()*w, Math.random()*h, 3, 3);
  }
},60,60);
const ground = plane(1400,1400,new THREE.MeshStandardMaterial({map:grassTex,roughness:1}));
ground.position.y = -0.02;
scene.add(ground);

/* ---------- Lagoa das Capivaras (norte) ---------- */
const waterTex = canvasTex(512,512,(ctx,w,h)=>{
  const g = ctx.createLinearGradient(0,0,0,h);
  g.addColorStop(0,'#2a7787'); g.addColorStop(.6,'#2f8496'); g.addColorStop(1,'#256b7b');
  ctx.fillStyle=g; ctx.fillRect(0,0,w,h);
  ctx.globalAlpha=.12; ctx.strokeStyle='#bfe3e8'; ctx.lineWidth=1.2;
  for(let i=0;i<46;i++){
    ctx.beginPath();
    const y = Math.random()*h;
    ctx.moveTo(Math.random()*w*0.3, y);
    ctx.bezierCurveTo(w*0.4,y+6, w*0.6,y-6, w*(0.7+Math.random()*0.3), y+2);
    ctx.stroke();
  }
  ctx.globalAlpha=1;
},3,3);
const waterMat = new THREE.MeshStandardMaterial({map:waterTex, roughness:.16, metalness:.06});
const water = plane(320,110, waterMat, 0, 0.03, -100.5);
scene.add(water);
const sandMat = mat(0xD8C9A3,1);
scene.add(plane(320,4.5,sandMat,0,0.045,-46.6));
[[-118,-49,26],[ -58,-47.5,20],[ 12,-48.5,24],[ 86,-47,22],[ 140,-50,30]].forEach(p=>{
  const cape = new THREE.Mesh(new THREE.CircleGeometry(p[2]*0.5, 22), new THREE.MeshStandardMaterial({map:grassTex, roughness:1}));
  cape.rotation.x=-Math.PI/2; cape.scale.set(1.7,0.65,1);
  cape.position.set(p[0],0.05,p[1]); cape.receiveShadow=true; scene.add(cape);
});
const reedMat = mat(0x5f7f43,1);
for(let i=0;i<26;i++){
  const x = -120 + Math.random()*240;
  if(Math.abs(x)<34 && Math.random()<.5) continue;
  const r = cyl(.06,.1,1.2+Math.random()*.9, reedMat, x, .6, -45.6-Math.random()*1.8, 5);
  scene.add(r);
}
for(let i=0;i<14;i++){
  const x=-150+i*23;
  scene.add(box(20,5+Math.random()*3,7, mat(0x46603c,1), x,2.6,-134,false,false));
}

/* ---------- Vías ---------- */
const asphaltMat = mat(PALETTE.asfalto,0.95);
const aceraMat = new THREE.MeshStandardMaterial({map:canvasTex(128,128,(ctx,w,h)=>{
  ctx.fillStyle='#c9c2b2'; ctx.fillRect(0,0,w,h);
  ctx.strokeStyle='rgba(90,84,70,.35)'; ctx.lineWidth=2;
  ctx.strokeRect(1,1,w-2,h-2); noise(ctx,w,h,.05,300);
},14,3), roughness:1});

scene.add(plane(190,9, asphaltMat, 0, 0.012, -33.5));
scene.add(plane(190,3, aceraMat, 0, 0.02, -27.5));
const dashMat = mat(0xEDE7D4,0.8);
for(let x=-92;x<=92;x+=8){
  if(Math.abs(x)<5) continue;
  scene.add(box(3.4,0.02,0.28,dashMat,x,0.03,-33.5,false));
}
for(let i=0;i<7;i++) scene.add(box(1.1,0.02,7.6,dashMat,-4.2+i*1.4,0.032,-33.5,false));

[[-1,-50],[1,50]].forEach(([s,cx])=>{
  scene.add(plane(6,78, asphaltMat, cx, 0.012, -1));
  scene.add(plane(2,78, aceraMat, cx - s*4, 0.02, -1));
  scene.add(plane(2,78, aceraMat, cx + s*4, 0.02, -1));
  for(let z=-32;z<=34;z+=8) scene.add(box(0.26,0.02,3.4,dashMat,cx,0.03,z,false));
});

/* Orla: paseo de madera + palmeras junto a la laguna */
const deckTex = canvasTex(256,128,(ctx,w,h)=>{
  ctx.fillStyle='#9a6a3e'; ctx.fillRect(0,0,w,h);
  ctx.strokeStyle='rgba(60,38,18,.55)'; ctx.lineWidth=2;
  for(let y=0;y<=h;y+=12){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(w,y);ctx.stroke();}
  noise(ctx,w,h,.06,260);
},22,1);
scene.add(plane(150,3.6, new THREE.MeshStandardMaterial({map:deckTex,roughness:.9}), 0, 0.05, -40.1));

/* ---------- Superficies del predio ---------- */
const plazaTex = canvasTex(256,256,(ctx,w,h)=>{
  ctx.fillStyle='#e6dfc9'; ctx.fillRect(0,0,w,h);
  ctx.strokeStyle='rgba(120,110,86,.4)'; ctx.lineWidth=1.6;
  for(let y=0;y<=h;y+=32){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(w,y);ctx.stroke();}
  for(let x=0;x<=w;x+=32){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,h);ctx.stroke();}
  noise(ctx,w,h,.05,300);
},4,3);
scene.add(plane(18,12,new THREE.MeshStandardMaterial({map:plazaTex,roughness:.95}),0,0.03,-20));

const paseoTex = canvasTex(512,512,(ctx,w,h)=>{
  ctx.fillStyle='#e9e2cc'; ctx.fillRect(0,0,w,h);
  ctx.strokeStyle='#17798A'; ctx.globalAlpha=.5; ctx.lineWidth=10; ctx.lineCap='round';
  for(let y=-40;y<h+40;y+=64){
    ctx.beginPath();
    for(let x=0;x<=w;x+=8){
      const yy = y + Math.sin(x/40)*14;
      x===0?ctx.moveTo(x,yy):ctx.lineTo(x,yy);
    }
    ctx.stroke();
  }
  ctx.globalAlpha=1; noise(ctx,w,h,.05,400);
},1.6,3);
scene.add(plane(18,30,new THREE.MeshStandardMaterial({map:paseoTex,roughness:.95}),0,0.03,1));
scene.add(plane(28,6,new THREE.MeshStandardMaterial({map:plazaTex,roughness:.95}),0,0.028,13));
scene.add(plane(18,6,new THREE.MeshStandardMaterial({map:plazaTex,roughness:.95}),-18,0.028,-11));
scene.add(plane(18,6,new THREE.MeshStandardMaterial({map:plazaTex,roughness:.95}), 18,0.028,-11));

const spineMat = new THREE.MeshStandardMaterial({map:grassTex,roughness:1});
scene.add(plane(6,9, spineMat, 0, 0.05, -7));
scene.add(plane(6,8, spineMat, 0, 0.05, 9));
const borderMat = mat(PALETTE.piedra,.9);
[[0,-7,6,9],[0,9,6,8]].forEach(b=>{
  scene.add(box(b[2]+.3,.22,.3,borderMat,b[0],.11,b[1]-b[3]/2,false));
  scene.add(box(b[2]+.3,.22,.3,borderMat,b[0],.11,b[1]+b[3]/2,false));
  scene.add(box(.3,.22,b[3],borderMat,b[0]-b[2]/2,.11,b[1],false));
  scene.add(box(.3,.22,b[3],borderMat,b[0]+b[2]/2,.11,b[1],false));
});

const fuente = new THREE.Group();
fuente.add(cyl(1.7,1.85,.5,mat(PALETTE.piedra,.85),0,.25,0,20));
const aguaFuente = new THREE.Mesh(new THREE.CircleGeometry(1.45,20),
  new THREE.MeshStandardMaterial({color:PALETTE.agua,roughness:.15,emissive:PALETTE.teal,emissiveIntensity:.18}));
aguaFuente.rotation.x=-Math.PI/2; aguaFuente.position.y=.42; fuente.add(aguaFuente);
fuente.add(cyl(.16,.2,.9,mat(PALETTE.piedra,.85),0,.85,0,10));
fuente.position.set(0,0,1.3); scene.add(fuente);

/* ---------- Estacionamientos (alas este / oeste) ---------- */
function parkingTexture(){
  return canvasTex(256,672,(ctx,w,h)=>{
    ctx.fillStyle='#3f4448'; ctx.fillRect(0,0,w,h); noise(ctx,w,h,.05,500);
    ctx.strokeStyle='#d8d4c8'; ctx.lineWidth=3;
    const stallPx = h/16.8;
    const depth = w*(5.5/16);
    for(let i=0;i<=16;i++){
      const y=i*stallPx;
      ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(depth,y);ctx.stroke();
      ctx.beginPath();ctx.moveTo(w-depth,y);ctx.lineTo(w,y);ctx.stroke();
    }
    ctx.fillStyle='rgba(60,110,150,.85)';
    ctx.fillRect(2, h*0.5-stallPx, depth-4, stallPx-3);
  });
}
const wingGeo = new THREE.PlaneGeometry(16,42);
[[-37],[37]].forEach(([cx])=>{
  const p = new THREE.Mesh(wingGeo, new THREE.MeshStandardMaterial({map:parkingTexture(),roughness:.96}));
  p.rotation.x=-Math.PI/2; p.position.set(cx,0.025,-1); p.receiveShadow=true; scene.add(p);
  scene.add(plane(4,6, asphaltMat, cx<0?-46:46, 0.022, -1));
});
const hedgeMat = mat(0x4f6b3d,1);
[[-37,-23.4],[37,-23.4],[-37,20.6],[37,20.6]].forEach(p=>scene.add(box(15.6,1,1,hedgeMat,p[0],.5,p[1])));
