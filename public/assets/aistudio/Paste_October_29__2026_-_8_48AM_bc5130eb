/* =====================================================================
   ARQUITECTURA — lenguaje strip center: negro + madera + canopy blanco
   ===================================================================== */
function slatsTexture(){
  return canvasTex(128,256,(ctx,w,h)=>{
    ctx.fillStyle='#7A4E2C'; ctx.fillRect(0,0,w,h);
    for(let i=0;i<40;i++){ ctx.fillStyle=['#8F5E37','#6E4426','#835431'][i%3];
      ctx.fillRect(Math.random()*w, Math.random()*h, 3, 10); }
    ctx.strokeStyle='rgba(40,22,8,.7)'; ctx.lineWidth=2;
    for(let x=0;x<=w;x+=14){ ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,h);ctx.stroke(); }
  });
}
const slatsMat  = new THREE.MeshStandardMaterial({map:slatsTexture(), roughness:.85});
const soffitMat = new THREE.MeshStandardMaterial({map:slatsTexture(), roughness:.9});
const steelMat  = mat(PALETTE.negro,.55,.5);
const frameMat  = mat(PALETTE.negro2,.5,.45);
const canopyMat = mat(PALETTE.blancoCanopy,.85);
const wallMatA  = mat(0xF1EDE2,.9);
const woodMat   = mat(PALETTE.madera,.8);
const woodMat2  = mat(PALETTE.maderaClara,.8);
const glassMat  = new THREE.MeshStandardMaterial({color:PALETTE.vidrio,roughness:.1,metalness:.3,transparent:true,opacity:.52});
const glassNight= new THREE.MeshStandardMaterial({color:0xFFE9B8,roughness:.3,emissive:0xFFC868,emissiveIntensity:0.0,transparent:true,opacity:.85});
const darkGlass = new THREE.MeshStandardMaterial({color:PALETTE.vidrioOscuro,roughness:.18,metalness:.3});
const glowWindows = [];   /* vidrios cálidos (locales / flats) */
const gymGlows   = [];    /* vidrios fríos del gimnasio */
const signGlows  = [];    /* cartelas retroiluminadas */

/* Cartela blanca de locatarios (nombres ficticios) */
function tenantSignMat(names, wPx=1280, big=false){
  const H = big?230:120;
  const tex = canvasTex(wPx,H,(ctx,w,h)=>{
    ctx.fillStyle='#F7F5EF'; ctx.fillRect(0,0,w,h);
    ctx.strokeStyle='rgba(27,31,35,.18)'; ctx.lineWidth=3; ctx.strokeRect(2,2,w-4,h-4);
    ctx.textAlign='center'; ctx.textBaseline='middle';
    if(big){
      ctx.fillStyle='#1B1F23'; ctx.font='800 118px Calibri, sans-serif';
      ctx.fillText(names[0], w/2, h*0.42);
      if(names[1]){ ctx.fillStyle='#D9A441'; ctx.font='700 52px Calibri, sans-serif';
        ctx.fillText(names[1], w/2, h*0.8); }
    } else {
      const seg=w/names.length;
      ctx.fillStyle='#1B1F23'; ctx.font='700 58px Calibri, sans-serif';
      names.forEach((n,i)=>{
        ctx.fillText(n, seg*(i+.5), h/2+2);
        if(i>0){ ctx.fillStyle='#D9A441'; ctx.fillRect(seg*i-2,h*0.22,4,h*0.56); ctx.fillStyle='#1B1F23'; }
      });
    }
  });
  const m = new THREE.MeshStandardMaterial({map:tex, roughness:.6,
    emissive:0xFFFFFF, emissiveMap:tex, emissiveIntensity:0});
  signGlows.push(m);
  return m;
}
/* Baranda metálica negra horizontal (estilo strip center) */
function steelRail(len, x,y,z, ry=0){
  const g=new THREE.Group();
  g.add(box(len,.06,.06,steelMat,0,1.02,0,false));
  g.add(box(len,.04,.04,steelMat,0,.68,0,false));
  g.add(box(len,.04,.04,steelMat,0,.34,0,false));
  const n=Math.max(2,Math.round(len/1.15));
  for(let i=0;i<=n;i++) g.add(box(.05,1.02,.05,steelMat,-len/2+i*(len/n),.51,0,false));
  g.position.set(x,y,z); g.rotation.y=ry;
  return g;
}
function pergola(w,d, x,y,z, matUse=woodMat){
  const g = new THREE.Group();
  g.add(box(w,.14,.14,matUse,0,0,-d/2));
  g.add(box(w,.14,.14,matUse,0,0, d/2));
  const n = Math.max(3, Math.round(w/0.9));
  for(let i=0;i<=n;i++) g.add(box(.1,.06,d+0.5, matUse, -w/2 + i*(w/n), .12, 0));
  g.position.set(x,y,z);
  return g;
}
function umbrella(x,z,colorHex=0xF3ECDD){
  const g = new THREE.Group();
  g.add(cyl(.05,.05,2.1,woodMat,0,1.05,0,6));
  const top = new THREE.Mesh(new THREE.ConeGeometry(1.35,.55,10,1,true), mat(colorHex,.85,0,{}));
  top.position.y=2.25; top.castShadow=true; g.add(top);
  g.position.set(x,0,z);
  return g;
}

/* ---- Bloque C/D: PB locales vidriados + cartela + PA flats (madera)
       coronado por gran canopy blanco volado ---- */
function buildBlock(cfg){
  const g = new THREE.Group();
  const GF=4.2, UF=3.4;
  const s = -1;                       /* fachada principal local al norte */
  const fz = s * cfg.d/2;

  /* PB: caja + vidriera de piso a techo con perfilería negra */
  g.add(box(cfg.w, GF, cfg.d-1.4, wallMatA, 0, GF/2, -s*0.7));
  g.add(box(cfg.w, .35, cfg.d-1.2, frameMat, 0, .17, -s*0.7));      /* zócalo negro */
  const glass = box(cfg.w-0.9, GF-1.0, .12, glassMat, 0, (GF-1.0)/2 + .35, fz-s*0.35, false);
  g.add(glass);
  const glassWarm = box(cfg.w-0.9, GF-1.0, .1, glassNight, 0, (GF-1.0)/2 + .35, fz-s*0.55, false,false);
  g.add(glassWarm); glowWindows.push(glassWarm);
  const nMod = cfg.shops || 3;
  for(let i=0;i<=nMod;i++){
    const px = -cfg.w/2 + i*(cfg.w/nMod);
    g.add(box(.22,GF,.22, frameMat, px, GF/2, fz-s*0.3));           /* parteluz negro */
    g.add(box(.18,GF+UF+.55,.18, steelMat, px, (GF+UF+.55)/2, fz+s*1.5)); /* columna esbelta al canopy */
  }
  /* losa intermedia (arcada cubierta) */
  g.add(box(cfg.w+.6, .32, cfg.d+2.6, canopyMat, 0, GF+.16, s*0.6));
  /* cartela blanca de locatarios sobre la vidriera */
  const brd = s*(0.6+(cfg.d+2.6)/2) - s*0.16;                        /* borde de losa */
  const signG = new THREE.Mesh(new THREE.PlaneGeometry(cfg.w+0.2,.95), cfg.signMat);
  signG.position.set(0, GF-0.32, brd); signG.rotation.y = Math.PI;   /* mira al frente (−Z local) */
  signG.castShadow=false; g.add(signG);
  g.add(box(cfg.w+0.3,.99,.1, frameMat, 0, GF-0.32, brd+s*0.06, false)); /* respaldo */

  /* PA flats: volumen en listones de madera, retirado (terrazas al frente) */
  const setback = 1.9;
  const upperD = cfg.d - setback;
  g.add(box(cfg.w, UF, upperD, slatsMat, 0, GF+.35+UF/2, -s*setback/2));
  const nWin = Math.max(3, Math.round(cfg.w/4));
  for(let i=0;i<nWin;i++){
    const px = -cfg.w/2 + (i+.5)*(cfg.w/nWin);
    g.add(box(2.3, 2.5, .1, frameMat, px, GF+.35+1.4, fz - s*(setback-0.0), false)); /* marco negro */
    g.add(box(2.0, 2.2, .1, darkGlass, px, GF+.35+1.35, fz - s*(setback-0.06), false));
    const winWarm = box(2.0, 2.2, .08, glassNight, px, GF+.35+1.35, fz - s*(setback+0.08), false,false);
    g.add(winWarm); glowWindows.push(winWarm);
  }
  /* baranda metálica negra de terrazas */
  g.add(steelRail(cfg.w-0.2, 0, GF+.35, fz - s*0.15));
  /* pérgolas parciales sobre terrazas */
  g.add(pergola(cfg.w*0.42, setback-0.2, -cfg.w*0.22, GF+.35+UF-0.1, fz - s*setback/2, woodMat2));

  /* CANOPY blanco volado con cara inferior de madera */
  const cw = cfg.w+3.2, cd = upperD+3.4;
  g.add(box(cw, .5, cd, canopyMat, 0, GF+.35+UF+0.42, -s*setback/2));
  g.add(box(cw-0.2, .05, cd-0.2, soffitMat, 0, GF+.35+UF+0.15, -s*setback/2, false));

  g.position.set(cfg.x, 0, cfg.z);
  scene.add(g);
  return g;
}

/* ---- Restaurante ancla: salón vidriado + cartela + rooftop; losa blanca volada ---- */
function buildAnchor(cfg){
  const g = new THREE.Group();
  const GF=4.4;
  const s = -1;                                     /* fachada a la laguna */
  const fz = s*cfg.d/2;
  g.add(box(cfg.w, GF, cfg.d-1.2, wallMatA, 0, GF/2, -s*0.6));
  g.add(box(cfg.w, .32, cfg.d-1.0, frameMat, 0, .16, -s*0.6));
  const glass = box(cfg.w-1.0, GF-0.9, .12, glassMat, 0,(GF-0.9)/2+.3, fz-s*.3,false);
  g.add(glass);
  const warm = box(cfg.w-1.0, GF-0.9, .1, glassNight, 0,(GF-0.9)/2+.3, fz-s*.5,false,false);
  g.add(warm); glowWindows.push(warm);
  const glassS = box(cfg.w-2, GF-1.4, .12, glassMat, 0,(GF-1.4)/2+.3, -fz+s*.3,false);
  g.add(glassS);
  for(let i=0;i<=4;i++){
    const px=-cfg.w/2+i*(cfg.w/4);
    g.add(box(.24,GF,.24,frameMat,px,GF/2,fz-s*.25));
  }
  /* losa blanca volada con cara de madera */
  g.add(box(cfg.w+2.6,.45,cfg.d+2.6, canopyMat, 0, GF+.22, 0));
  g.add(box(cfg.w+2.4,.05,cfg.d+2.4, soffitMat, 0, GF-0.02, 0, false));
  /* cartela con el nombre */
  const sign = new THREE.Mesh(new THREE.PlaneGeometry(cfg.w*0.72,1.0), cfg.signMat);
  sign.position.set(0, GF-0.42, fz+s*1.34); sign.rotation.y=Math.PI; g.add(sign);
  g.add(box(cfg.w*0.72+0.2,1.04,.1, frameMat, 0, GF-0.42, fz+s*1.4, false));
  /* rooftop: baranda negra + deck + pérgola + sombrillas + mesitas */
  g.add(steelRail(cfg.w-0.2, 0, GF+.45, fz+s*0.1));
  g.add(steelRail(cfg.w-0.2, 0, GF+.45, -fz-s*0.1));
  g.add(steelRail(cfg.d-0.2, -cfg.w/2+.1, GF+.45, 0, Math.PI/2));
  g.add(steelRail(cfg.d-0.2,  cfg.w/2-.1, GF+.45, 0, Math.PI/2));
  const deck = plane(cfg.w-0.6, cfg.d-0.6, new THREE.MeshStandardMaterial({map:deckTex,roughness:.9}));
  deck.position.set(0,GF+.46,0); g.add(deck);
  g.add(pergola(cfg.w*0.5, cfg.d*0.55, -cfg.w*0.18, GF+3.0, s*0.5));
  const pw=cfg.w*0.25, pd=cfg.d*0.275;
  [[-1,-1],[1,-1],[-1,1],[1,1]].forEach(q=>{
    g.add(box(.14,2.55,.14,steelMat, -cfg.w*0.18+q[0]*pw, GF+.45+1.28, s*0.5+q[1]*pd));
  });
  const u1=umbrella(cfg.w*0.26, s*1.6, PALETTE.dorado); u1.position.y=GF+.45; g.add(u1);
  const u2=umbrella(-cfg.w*0.05, s*2.4, 0xF3ECDD); u2.position.y=GF+.45; g.add(u2);
  const u3=umbrella(0,0,0xF3ECDD); u3.position.set(cfg.w*0.3,GF+.45,-s*2.2); g.add(u3);
  for(let i=0;i<4;i++){
    const t=cyl(.5,.5,.06,woodMat2, -cfg.w*0.3+i*(cfg.w*0.2), GF+.83, (i%2? -1.8:1.8)*s,10,false);
    g.add(t); g.add(cyl(.06,.08,.72,woodMat, t.position.x, GF+.45+.36, t.position.z,6,false));
  }
  g.position.set(cfg.x,0,cfg.z);
  scene.add(g);
  return g;
}

/* ---- Bloque E: PB locales + P2 GIMNASIO vidriado + ROOFTOP fitness ---- */
function buildGymBlock(cfg){
  const g = new THREE.Group();
  const GF=4.2, UF2=4.0;
  const s=-1, fz=s*cfg.d/2;
  /* PB idéntico al lenguaje de locales */
  g.add(box(cfg.w, GF, cfg.d-1.4, wallMatA, 0, GF/2, -s*0.7));
  g.add(box(cfg.w, .35, cfg.d-1.2, frameMat, 0, .17, -s*0.7));
  const glass = box(cfg.w-0.9, GF-1.0, .12, glassMat, 0, (GF-1.0)/2 + .35, fz-s*0.35, false);
  g.add(glass);
  const glassWarm = box(cfg.w-0.9, GF-1.0, .1, glassNight, 0, (GF-1.0)/2 + .35, fz-s*0.55, false,false);
  g.add(glassWarm); glowWindows.push(glassWarm);
  const nMod = cfg.shops || 4;
  for(let i=0;i<=nMod;i++){
    const px = -cfg.w/2 + i*(cfg.w/nMod);
    g.add(box(.22,GF,.22, frameMat, px, GF/2, fz-s*0.3));
    g.add(box(.18,GF+.7,.18, steelMat, px, (GF+.7)/2, fz+s*1.5));
  }
  g.add(box(cfg.w+.6, .32, cfg.d+2.6, canopyMat, 0, GF+.16, s*0.6));
  const brd = s*(0.6+(cfg.d+2.6)/2) - s*0.16;
  const signG = new THREE.Mesh(new THREE.PlaneGeometry(cfg.w+0.2,.95), cfg.signMat);
  signG.position.set(0, GF-0.32, brd); signG.rotation.y=Math.PI; g.add(signG);
  g.add(box(cfg.w+0.3,.99,.1, frameMat, 0, GF-0.32, brd+s*0.06, false));

  /* P2: caja de vidrio del gimnasio (muro cortina, perfiles negros) */
  const w2=cfg.w-2, d2=cfg.d-1.5, y0=GF+.35, ceil=y0+UF2;
  g.add(box(w2, .2, d2, frameMat, 0, y0+.1, 0));                   /* piso perimetral */
  const floorIn = plane(w2-0.6, d2-0.6, mat(0x2B3136,.9)); floorIn.position.set(0,y0+.22,0); g.add(floorIn);
  [[0,-d2/2,w2,0],[0,d2/2,w2,Math.PI],[-w2/2,0,d2,Math.PI/2],[w2/2,0,d2,-Math.PI/2]].forEach(f=>{
    const gl=new THREE.Mesh(new THREE.PlaneGeometry(f[2]-0.2,UF2-0.5), glassMat);
    gl.position.set(f[0],y0+UF2/2,f[1]); gl.rotation.y=f[3]; g.add(gl);
    const cold=new THREE.Mesh(new THREE.PlaneGeometry(f[2]-0.2,UF2-0.5),
      new THREE.MeshStandardMaterial({color:0xDFEFF6,transparent:true,opacity:.8,emissive:0xCFE6F2,emissiveIntensity:0}));
    const ix = f[0]===0 ? 0 : (f[0]<0 ? 0.12 : -0.12);
    const iz = f[1]===0 ? 0 : (f[1]<0 ? 0.12 : -0.12);
    cold.position.set(f[0]+ix, y0+UF2/2, f[1]+iz);
    cold.rotation.y=f[3]; g.add(cold); gymGlows.push(cold.material);
    const nP=Math.round(f[2]/2.4);
    for(let i=0;i<=nP;i++){
      const off=-f[2]/2+0.1+i*((f[2]-0.2)/nP);
      const p = (Math.abs(f[1])>0.1)
        ? box(.14,UF2,.14,frameMat, off, y0+UF2/2, f[1], false)
        : box(.14,UF2,.14,frameMat, f[0], y0+UF2/2, off, false);
      g.add(p);
    }
  });
  [[-w2/2,-d2/2],[w2/2,-d2/2],[-w2/2,d2/2],[w2/2,d2/2]].forEach(c=>
    g.add(box(.24,UF2,.24,steelMat,c[0],y0+UF2/2,c[1])));
  /* equipamiento interior esquemático + usuarios */
  [-8.5,-5.5,-2.5].forEach(x=> g.add(box(1.2,2.0,.5, frameMat, x, y0+1.2, -1, false)));
  [3.2,5.8].forEach(x=>{ g.add(box(.8,.28,1.7, steelMat, x, y0+.36, -1, false));
    g.add(box(.8,.9,.14, frameMat, x, y0+1.0, -1.7, false)); });
  [[-7,.6],[1,.2],[7,-.8]].forEach(p=>{
    g.add(cyl(.15,.19,.9, mat(0x8fa5a8,.95), p[0], y0+.68, p[1], 8, false));
    const hd=new THREE.Mesh(new THREE.SphereGeometry(.13,8,8),mat(0xC9A184,.9));
    hd.position.set(p[0],y0+1.3,p[1]); g.add(hd);
  });
  /* cartela grande del gimnasio hacia el paseo */
  const gymSign = new THREE.Mesh(new THREE.PlaneGeometry(9,1.5), cfg.gymSignMat);
  gymSign.position.set(0, ceil-0.95, -d2/2-0.18); gymSign.rotation.y=Math.PI; g.add(gymSign);
  g.add(box(9.2,1.56,.1, frameMat, 0, ceil-0.95, -d2/2-0.12, false));

  /* ROOFTOP fitness */
  const rw=cfg.w-0.6, rd=cfg.d-0.4, ry=ceil+0.17;
  g.add(box(cfg.w+1.0,.4,cfg.d+1.0, canopyMat, 0, ceil+0.02, 0));   /* fascia blanca perimetral */
  const rdeck = plane(rw-0.4, rd-0.4, new THREE.MeshStandardMaterial({map:deckTex,roughness:.9}));
  rdeck.position.set(0,ry+0.05,0); g.add(rdeck);
  const turf = plane(9,5.6, mat(0x7FA85B,1)); turf.position.set(-7.6,ry+0.06,0.4); g.add(turf);
  g.add(steelRail(rw, 0, ry, -rd/2+.1));
  g.add(steelRail(rw, 0, ry,  rd/2-.1));
  g.add(steelRail(rd, -rw/2+.1, ry, 0, Math.PI/2));
  g.add(steelRail(rd,  rw/2-.1, ry, 0, Math.PI/2));
  /* pérgola blanca moderna (zona este) */
  g.add(pergola(9, 6.4, 7.6, ry+2.8, 0.2, canopyMat));
  [[-1,-1],[1,-1],[-1,1],[1,1]].forEach(q=>
    g.add(box(.16,2.8,.16, canopyMat, 7.6+q[0]*4.2, ry+1.4, 0.2+q[1]*2.9)));
  /* estructuras de calistenia sobre el césped */
  [[-10.6,-0.8],[-5.0,1.4]].forEach(p=>{
    g.add(box(.09,2.3,.09,steelMat,p[0]-1,ry+1.15,p[1],false));
    g.add(box(.09,2.3,.09,steelMat,p[0]+1,ry+1.15,p[1],false));
    g.add(box(2.2,.08,.08,steelMat,p[0],ry+2.28,p[1],false));
  });
  const ru=umbrella(2.2,-2.0,PALETTE.dorado); ru.position.y=ry; g.add(ru);
  [[1.8,1.8,0x9BB1A0],[-7.4,0.4,0xB98F6D]].forEach(p=>{
    g.add(cyl(.15,.19,.9, mat(p[2],.95), p[0], ry+.5, p[1], 8, false));
    const hd=new THREE.Mesh(new THREE.SphereGeometry(.13,8,8),mat(0xC9A184,.9));
    hd.position.set(p[0],ry+1.12,p[1]); g.add(hd);
  });

  g.position.set(cfg.x,0,cfg.z);
  scene.add(g);
  return g;
}

/* ---- Escalera exterior metálica del gimnasio (lado este del bloque E) ---- */
function buildStair(){
  const g=new THREE.Group();
  const stepsMat = mat(0xB9B2A5,.7,.3);
  function flight(len, rise, cx, cy, cz){
    const L=Math.hypot(len,rise);
    const f=box(1.3,.14,L, stepsMat, cx, cy, cz);
    f.rotation.x=-Math.atan(rise/len);
    g.add(f);
    [[-0.62],[0.62]].forEach(([ox])=>{
      const r=box(.05,.06,L, steelMat, cx+ox, cy+0.58, cz,false);
      r.rotation.x=-Math.atan(rise/len); g.add(r);
      const r2=box(.05,.06,L, steelMat, cx+ox, cy+0.28, cz,false);
      r2.rotation.x=-Math.atan(rise/len); g.add(r2);
    });
  }
  flight(4, 4.55, 14.9, 2.27, 18.5);                 /* suelo → P2 */
  g.add(box(2.6,.14,1.7, stepsMat, 14.2, 4.55, 21.3));/* plataforma acceso gym */
  g.add(steelRail(1.7, 15.5, 4.55, 21.3, Math.PI/2));
  flight(4, 4.17, 14.9, 6.63, 24);                    /* P2 → rooftop */
  [[14.9,4.55,21.9],[14.9,8.6,26],[14.9,2.2,16.6]].forEach(p=>
    g.add(box(.16,p[1],.16, steelMat, p[0], p[1]/2, p[2])));
  scene.add(g);
}

/* ---- Tótem / pylon de acceso ---- */
function buildTotem(){
  const g=new THREE.Group();
  g.add(box(1.2,.9,1.2, steelMat, 0,.45,0));
  g.add(box(1.7,7.6,.55, canopyMat, 0,4.6,0));
  const t=canvasTex(512,1024,(ctx,w,h)=>{
    ctx.fillStyle='#F7F5EF'; ctx.fillRect(0,0,w,h);
    ctx.fillStyle='#D9A441'; ctx.fillRect(0,h*0.30,w,10);
    ctx.textAlign='center'; ctx.fillStyle='#0E3A53';
    ctx.font='600 92px Cambria, Georgia, serif';
    ctx.fillText('VILA',w/2,h*0.12);
    ctx.fillText('CAPIVARAS',w/2,h*0.235);
    ctx.fillStyle='#17798A'; ctx.font='44px Calibri, sans-serif';
    ctx.fillText('paseo · gym · flats',w/2,h*0.38);
  });
  const pm=new THREE.MeshStandardMaterial({map:t,roughness:.6,emissive:0xFFFFFF,emissiveMap:t,emissiveIntensity:0});
