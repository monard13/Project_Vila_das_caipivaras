    signGlows.forEach(m=>m.emissiveIntensity=0);
    lampHeads.forEach(h=>h.material.emissiveIntensity=0);
    waterMat.color.set(0xFFFFFF);
    bSunset.classList.remove('on'); bSunset.textContent='☀ Atardecer';
  }
}
bSunset.onclick=()=>setDaytime(!sunset);

/* ---------- Etiquetas on/off · PNG · pantalla completa ---------- */
const bLabels=document.getElementById('b-labels');
bLabels.onclick=()=>{
  labelGroup.visible=!labelGroup.visible;
  bLabels.classList.toggle('on',labelGroup.visible);
};
document.getElementById('b-png').onclick=()=>{
  renderer.render(scene,camera);
  const a=document.createElement('a');
  a.download='vila-capivaras-rediseno.png';
  a.href=renderer.domElement.toDataURL('image/png');
  a.click();
};
document.getElementById('b-full').onclick=()=>{
  if(document.fullscreenElement) document.exitFullscreen();
  else (document.documentElement.requestFullscreen||document.documentElement.webkitRequestFullscreen).call(document.documentElement);
};

/* ---------- Bucle ---------- */
const reduceMotion=matchMedia('(prefers-reduced-motion: reduce)').matches;
if(reduceMotion) ctl.auto=false;
const needle=document.getElementById('needle');
const clock=new THREE.Clock();
function ease(t){return t<.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2;}
function animate(){
  requestAnimationFrame(animate);
  const dt=Math.min(clock.getDelta(),.05);
  if(tween.active){
    tween.t+=dt/tween.dur;
    const k=ease(Math.min(tween.t,1));
    ctl.radius=THREE.MathUtils.lerp(tween.from.radius,tween.to.radius,k);
    ctl.phi   =THREE.MathUtils.lerp(tween.from.phi,   tween.to.phi,   k);
    ctl.theta =THREE.MathUtils.lerp(tween.from.theta, tween.to.theta, k);
    ctl.target.lerpVectors(tween.from.target,tween.to.target,k);
    if(tween.t>=1) tween.active=false;
  } else if(ctl.auto){
    ctl.theta+=dt*0.045;
  }
  if(!reduceMotion){ waterTex.offset.x+=dt*0.008; waterTex.offset.y+=dt*0.004; }
  applyCamera();
  const dir=new THREE.Vector3(); camera.getWorldDirection(dir);
  needle.style.transform='rotate('+((Math.atan2(dir.x,dir.z))*180/Math.PI+180)+'deg)';
  renderer.render(scene,camera);
}
addEventListener('resize',()=>{
  camera.aspect=innerWidth/innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth,innerHeight);
});

/* arranque */
setDaytime(false);
applyCamera();
animate();
const loader=document.getElementById('loader');
setTimeout(()=>{loader.style.opacity='0'; setTimeout(()=>loader.remove(),650);},450);
setTimeout(()=>{const h=document.getElementById('hint'); if(h) h.style.opacity='0';},9000);
</script>
