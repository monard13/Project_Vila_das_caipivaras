function applyCamera(){
  ctl.theta+=ctl.dTheta; ctl.phi+=ctl.dPhi; ctl.radius*= (1+ctl.dRad);
  ctl.dTheta*=.85; ctl.dPhi*=.85; ctl.dRad*=.8;
  ctl.phi=THREE.MathUtils.clamp(ctl.phi,ctl.minPhi,ctl.maxPhi);
  ctl.radius=THREE.MathUtils.clamp(ctl.radius,ctl.minR,ctl.maxR);
